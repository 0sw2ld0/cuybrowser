{
  "name": "cuybrowser",
  "version": "0.1.0",
  "description": "Control de Chrome para agentes de IA por MCP, CLI y HTTP local, con confirmación humana y snapshots eficientes en tokens.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cuybrowser": "dist/adapters/cli.js"
  },
  "files": [
    "dist",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && vitest run",
    "docs": "npm run build && mkdir -p docs && node dist/adapters/cli.js docs --format agents-md > docs/AGENTS.md",
    "build:bin": "node scripts/build-binaries.mjs",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^14.0.3",
    "playwright-core": "^1.64.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "bun": "^1.4.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "mcp",
    "chrome",
    "browser-automation",
    "ai-agents",
    "playwright"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0sw2ld0/cuybrowser.git"
  },
  "homepage": "https://github.com/0sw2ld0/cuybrowser#readme",
  "bugs": {
    "url": "https://github.com/0sw2ld0/cuybrowser/issues"
  }
}
